# Copy to .env and fill your Fastmail account details
# Fastmail defaults are used if host/port are omitted
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USER=your-fastmail-address@example.com
SMTP_PASS=your-fastmail-app-password

# Optional staging access gate
STAGING_ENABLED=false
STAGING_PASSWORD=change-this-for-staging
STAGING_SESSION_SECRET=replace-with-long-random-secret

# Optional
PORT=3000
